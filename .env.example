# Configurações do Banco de Dados MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cep_db
MYSQL_USER=cep_user
MYSQL_PASSWORD=cep_password
MYSQL_ROOT_PASSWORD=cep_root_password

# Conexão Assíncrona SQLAlchemy (asyncmy)
DATABASE_URL=mysql+asyncmy://cep_user:cep_password@localhost:3306/cep_db

# Configurações de Segurança e JWT
SECRET_KEY=change_this_secret_key_in_production_super_safe_random_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configurações Gerais da Aplicação
PROJECT_NAME="Controle Estatístico de Processos (CEP)"
API_V1_STR=/api/v1
